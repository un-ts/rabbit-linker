{
  "name": "rabbit-linker",
  "version": "0.1.0",
  "type": "module",
  "description": "Stable link that redirects to random resource download link via Vercel.",
  "repository": "git@github.com:un-ts/rabbit-linker.git",
  "author": "JounQin <admin@1stg.me>",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "tsx scripts/build",
    "lint": "run-p 'lint:*'",
    "lint:es": "eslint . --cache",
    "lint:tsc": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "start": "vc dev"
  },
  "devDependencies": {
    "@1stg/common-config": "^15.0.0",
    "@octokit/request": "^10.0.0",
    "@types/web": "^0.0.355",
    "commitlint": "^21.0.0",
    "eslint": "^10.0.0",
    "lint-staged": "^17.0.0",
    "npm-run-all": "^4.1.5",
    "simple-git-hooks": "^2.9.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.0",
    "vercel": "^59.0.0"
  },
  "resolutions": {
    "prettier": "^3.0.0"
  },
  "commitlint": {
    "extends": "@1stg"
  },
  "eslintConfig": {
    "extends": "@1stg"
  },
  "eslintIgnore": [
    "/public/index.html",
    "!/.*.js"
  ],
  "prettier": "@1stg/prettier-config",
  "renovate": {
    "extends": [
      "github>1stG/configs"
    ]
  }
}
